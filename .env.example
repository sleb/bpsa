# Copy this file to .env and fill in your Firebase project values.
# Find these in Firebase Console → Project Settings → Your apps → SDK setup.
#
# For local development against emulators, fill in real Firebase values and set
# BUN_PUBLIC_USE_EMULATOR=true. For production deployment, omit or set it to false.

BUN_PUBLIC_FIREBASE_API_KEY=your-api-key
BUN_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
BUN_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
BUN_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
BUN_PUBLIC_USE_EMULATOR=true
