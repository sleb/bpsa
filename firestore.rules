rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveEditor() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin'];
    }

    // Public schedule reads; only active editors/admins may write
    match /schedules/{dayId} {
      allow read: if true;
      allow write: if isActiveEditor();
    }

    // Version history is public-readable; only editors/admins may write
    match /schedules/{dayId}/versions/{versionId} {
      allow read: if true;
      allow write: if isActiveEditor();
    }

    // Editors can read their own user doc; no client may write (provisioning is manual)
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
