---
import ScheduleDay from "@/components/ScheduleDay.astro";
import type { SanityScheduleDay } from "@/lib/sanity";

interface Props {
  days: SanityScheduleDay[];
}

const { days } = Astro.props;
---

<div class="min-h-screen bg-background text-foreground">
  <header class="sticky top-0 z-10 border-b bg-background/95 backdrop-blur">
    <div class="mx-auto max-w-lg px-4 py-3">
      <h1 class="text-lg font-semibold">BP Youth Summer Adventure 2026</h1>
      <nav class="mt-2 grid grid-cols-3 gap-1">
        {days.map((d) => (
          <button
            data-day-tab={d.date}
            class="truncate rounded-md px-3 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:bg-muted"
          >
            {d.title}
          </button>
        ))}
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-lg px-4 py-4">
    {days.map((d) => <ScheduleDay day={d} />)}
  </main>
</div>

<script>
  import {
    getCurrentTimeMinutes,
    getRedirectDay,
    getTodayCampDay,
    parseTimeToMinutes,
  } from "@/lib/campTime";

  const ACTIVE_TAB = ["bg-primary", "text-primary-foreground"];
  const INACTIVE_TAB = ["text-muted-foreground", "hover:bg-muted"];

  function updateNowIndicator(date: string): void {
    const list = document.querySelector<HTMLElement>(
      `[data-day-content="${date}"]`,
    );
    if (!list) return;
    const rows = list.querySelectorAll<HTMLElement>("li[data-time]");

    for (const row of rows) {
      row.classList.remove("bg-primary/10", "ring-1", "ring-primary");
      row.classList.add("hover:bg-muted/50");
      row.querySelector(".entry-dot")?.classList.add("invisible");
    }

    if (date !== getTodayCampDay()) return;

    const now = getCurrentTimeMinutes();
    let activeRow: HTMLElement | null = null;
    for (const row of rows) {
      // biome-ignore lint/style/noNonNullAssertion: li[data-time] selector guarantees data-time is present
      if (parseTimeToMinutes(row.dataset.time!) <= now) activeRow = row;
    }

    if (activeRow) {
      activeRow.classList.add("bg-primary/10", "ring-1", "ring-primary");
      activeRow.classList.remove("hover:bg-muted/50");
      activeRow.querySelector(".entry-dot")?.classList.remove("invisible");
    }
  }

  function showDay(date: string): void {
    document.querySelectorAll<HTMLElement>("[data-day-content]").forEach((el) => {
      el.hidden = true;
    });
    document
      .querySelectorAll<HTMLButtonElement>("[data-day-tab]")
      .forEach((btn) => {
        btn.classList.remove(...ACTIVE_TAB);
        btn.classList.add(...INACTIVE_TAB);
      });

    const content = document.querySelector<HTMLElement>(
      `[data-day-content="${date}"]`,
    );
    const tab = document.querySelector<HTMLButtonElement>(
      `[data-day-tab="${date}"]`,
    );
    if (content) content.hidden = false;
    if (tab) {
      tab.classList.add(...ACTIVE_TAB);
      tab.classList.remove(...INACTIVE_TAB);
    }

    updateNowIndicator(date);
  }

  document
    .querySelectorAll<HTMLButtonElement>("[data-day-tab]")
    .forEach((btn) => {
      // biome-ignore lint/style/noNonNullAssertion: [data-day-tab] selector guarantees the attribute is present
      btn.addEventListener("click", () => showDay(btn.dataset.dayTab!));
    });

  showDay(getRedirectDay());

  setInterval(() => {
    const visible = document.querySelector<HTMLElement>(
      "[data-day-content]:not([hidden])",
    );
    if (visible?.dataset.dayContent) updateNowIndicator(visible.dataset.dayContent);
  }, 60_000);
</script>
