---
import type { SanityScheduleDay } from '@/lib/sanity'
import { formatTime12h } from '@/lib/campTime'

interface Props {
  days: SanityScheduleDay[]
  currentDate: string
}

const { days, currentDate } = Astro.props
const day = days.find((d) => d.date === currentDate)!
const entries = day.entries ?? []
---

<div class="min-h-screen bg-background text-foreground">
  <header class="sticky top-0 z-10 border-b bg-background/95 backdrop-blur">
    <div class="mx-auto max-w-lg px-4 py-3">
      <h1 class="text-lg font-semibold">BP Youth Summer Adventure 2026</h1>
      <nav class="mt-2 flex gap-1 overflow-x-auto">
        {days.map((d) => (
          <a
            href={`/schedule/${d.date}`}
            class={d.date === currentDate
              ? 'shrink-0 rounded-md px-3 py-1.5 text-sm font-medium transition-colors bg-primary text-primary-foreground'
              : 'shrink-0 rounded-md px-3 py-1.5 text-sm font-medium transition-colors text-muted-foreground hover:bg-muted'}
          >
            {d.title}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main class="mx-auto max-w-lg px-4 py-4" data-page-date={currentDate}>
    <ul class="space-y-1">
      {entries.map((entry) => (
        <li
          data-time={entry.time}
          class="flex gap-3 rounded-lg px-3 py-3 transition-colors hover:bg-muted/50"
        >
          <span class="entry-dot mt-0.5 h-2 w-2 shrink-0 rounded-full bg-primary invisible" aria-hidden="true"></span>
          <div class="min-w-0">
            <div class="flex items-baseline gap-2">
              <span class="shrink-0 text-sm font-mono text-muted-foreground">
                {formatTime12h(entry.time)}
              </span>
              <span class="font-medium">{entry.activity}</span>
            </div>
            {entry.location && (
              <p class="mt-0.5 text-sm text-muted-foreground">{entry.location}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </main>
</div>

<script>
  function parseMinutes(time: string): number {
    const [h, m] = time.split(':').map(Number)
    return h! * 60 + m!
  }

  function getPacificMinutes(): number {
    const parts = new Intl.DateTimeFormat('en-US', {
      timeZone: 'America/Los_Angeles',
      hour: 'numeric',
      minute: 'numeric',
      hour12: false,
    }).formatToParts(new Date())
    const h = parseInt(parts.find((p) => p.type === 'hour')!.value, 10)
    const m = parseInt(parts.find((p) => p.type === 'minute')!.value, 10)
    return h * 60 + m
  }

  function getTodayPacific(): string {
    return new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Los_Angeles',
      dateStyle: 'short',
    }).format(new Date())
  }

  function updateActive(): void {
    const main = document.querySelector<HTMLElement>('[data-page-date]')
    if (!main) return
    const rows = main.querySelectorAll<HTMLElement>('li[data-time]')

    for (const row of rows) {
      row.classList.remove('bg-primary/10', 'ring-1', 'ring-primary')
      row.classList.add('hover:bg-muted/50')
      row.querySelector('.entry-dot')?.classList.add('invisible')
    }

    if (main.dataset.pageDate !== getTodayPacific()) return

    const now = getPacificMinutes()
    let activeRow: HTMLElement | null = null
    for (const row of rows) {
      if (parseMinutes(row.dataset.time!) <= now) activeRow = row
    }

    if (activeRow) {
      activeRow.classList.add('bg-primary/10', 'ring-1', 'ring-primary')
      activeRow.classList.remove('hover:bg-muted/50')
      activeRow.querySelector('.entry-dot')?.classList.remove('invisible')
    }
  }

  updateActive()
  setInterval(updateActive, 60_000)
</script>
