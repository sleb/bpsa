---
import ScheduleEntry from "@/components/ScheduleEntry.astro";
import type { SanityScheduleDay } from "@/lib/sanity";

interface Props {
  day: SanityScheduleDay;
}

const { day } = Astro.props;
---

<div data-day-content={day.date} class="space-y-1" hidden>
  {(day.entries ?? []).map((entry) => <ScheduleEntry entry={entry} />)}
</div>
