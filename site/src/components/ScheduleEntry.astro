---
import EntryCard from "@/components/EntryCard.astro";
import { formatTime12h } from "@/lib/campTime";
import type { SanityEntry } from "@/lib/sanity";

interface Props {
  entry: SanityEntry;
}

const { entry } = Astro.props;
---

<EntryCard time={formatTime12h(entry.time)} title={entry.activity}>
  {entry.location && (
    <p class="mt-0.5 text-sm text-muted-foreground">{entry.location}</p>
  )}
</EntryCard>
