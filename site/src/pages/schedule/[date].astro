---
import Layout from '@/layouts/Layout.astro'
import ScheduleDay from '@/components/ScheduleDay.astro'
import { getAllScheduleDays } from '@/lib/sanity'
import type { SanityScheduleDay } from '@/lib/sanity'

export async function getStaticPaths() {
  const days = await getAllScheduleDays()
  return days.map((day) => ({
    params: { date: day.date },
    props: { day, days },
  }))
}

interface Props {
  day: SanityScheduleDay
  days: SanityScheduleDay[]
}
const { day, days } = Astro.props
---

<Layout title={`${day.title} — BP Youth Summer Adventure 2026`}>
  <ScheduleDay days={days} currentDate={day.date} />
</Layout>
